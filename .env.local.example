SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gates the whole site behind one shared password — see proxy.ts and
# lib/site-auth.ts. Pick anything; changing it later signs everyone out.
SITE_PASSWORD=choose-a-password

# Claude API key for the in-app "Add from link / text / photo" recipe import.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed on Vercel. Vercel sends this on cron invocations of
# /api/keepalive (the daily ping that stops Supabase's free tier from pausing
# the project). Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=choose-a-long-random-string
