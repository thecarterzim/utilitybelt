SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gates the whole site behind one shared password — see proxy.ts and
# lib/site-auth.ts. Pick anything; changing it later signs everyone out.
SITE_PASSWORD=choose-a-password

# Read-only token for /api/ingredients-feed (see that route) — paste this
# into the recipe-import Claude Skill's instructions so it can fetch your
# current ingredient library. A long random string; changing it invalidates
# any Skill copies of the old one.
INGREDIENTS_FEED_TOKEN=a-long-random-string

# Claude API key for the in-app "Add from link / text / photo" recipe import.
ANTHROPIC_API_KEY=sk-ant-...
